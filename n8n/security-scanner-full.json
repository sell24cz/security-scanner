      "parameters": {
        "authentication": "privateKey",
        "resource": "file",
        "operation": "download",
        "path": "={{ (() => { const id = $('Report fields').first().json.scan_id; const expected = '/opt/security-scanner/data/results/full_' + id + '/summary.txt'; const path = ($json.stdout || '').match(/^SUMMARY=(.+)$/m)?.[1]?.trim(); if (Number($json.code ?? 0) !== 0 || path !== expected) throw new Error('Summary path does not match scan'); return path; })() }}",
        "options": {}
      },
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [
        1584,
        176
      ],
      "id": "8f0a3ebd-8af8-428b-94ad-c700504ed760",
      "name": "Download summary"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1f384e8c-51bc-4f23-9e30-bb027b6bd2d5",
              "name": "critical",
              "value": "={{ (() => { const value = ($json.stdout || '').match(/^CRITICAL=(\\d+)$/m)?.[1]; if (value === undefined) throw new Error('Missing CRITICAL in completed scan'); return value; })() }}",
              "type": "string"
            },
            {
              "id": "238106a9-db5d-42fa-9750-109b54d464a5",
              "name": "ports",
              "value": "={{ (() => { const value = ($json.stdout || '').match(/^PORTS=(\\d+)$/m)?.[1]; if (value === undefined) throw new Error('Missing PORTS in completed scan'); return value; })() }}",
              "type": "string"
            },
            {
              "id": "39bf3973-1b5b-4594-98e7-3434c02d3f69",
              "name": "http",
              "value": "={{ (() => { const value = ($json.stdout || '').match(/^HTTP=(\\d+)$/m)?.[1]; if (value === undefined) throw new Error('Missing HTTP in completed scan'); return value; })() }}",
              "type": "string"
            },
            {
              "id": "ff5a3e58-15a5-4b68-bd24-f304911e8d05",
              "name": "prefix_ips",
              "value": "={{ (() => { const value = ($json.stdout || '').match(/^PREFIX_IPS=(\\d+)$/m)?.[1]; if (value === undefined) throw new Error('Missing PREFIX_IPS in completed scan'); return value; })() }}",
              "type": "string"
            },
            {
              "id": "fe01fda0-2781-4454-a456-6127ccf08408",
              "name": "critical_list",
              "value": "={{ ($json.stdout || '').match(/CRITICAL_LIST_BEGIN([\\s\\S]*?)CRITICAL_LIST_END/)?.[1]?.trim() || 'Critical details unavailable; inspect scan results.' }}",
              "type": "string"
            },
            {
              "id": "b950e394-1ecc-4203-9ab2-2d2786a1d40c",
              "name": "scan_id",
              "value": "={{ $('Scan ID').first().json.scan_id }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        1392,
        96
      ],
      "id": "b14e3bcb-a417-4f70-9bb7-8c6b40fce6d0",
      "name": "Report fields"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "47849679-1431-4d43-b455-55c3bd5416f6",
              "name": "scan_id",
              "value": "={{ (() => { const id = ($json.stdout || '').match(/^SCAN_ID=([0-9]{8}_[0-9]{6})$/m)?.[1]; if (Number($json.code ?? 0) !== 0 || !id) throw new Error('Start did not return a valid scan ID'); return id; })() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
