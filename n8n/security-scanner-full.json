      "name": "Send report"
    },
    {
      "parameters": {
        "authentication": "privateKey",
        "command": "sudo /opt/security-scanner/scripts/start-full-scan.sh"
      },
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [
        336,
        -160
      ],
      "id": "9a96d24e-3a0e-4b78-9755-5c2fa051b272",
      "name": "Start FULL"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "7e324fdd-6ae4-414a-9fc3-06e63bb073da",
              "name": "status",
              "value": "={{ ($json.stdout || '').match(/^STATUS=([A-Z_]+)$/m)?.[1] || 'UNKNOWN' }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        800,
        64
      ],
      "id": "d6da5e99-20e4-48c4-94de-fdc9ab51d1ae",
      "name": "Status"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "843c3e1d-3731-4eda-9006-a1e57800327e",
              "leftValue": "={{$json.status}}",
              "rightValue": "COMPLETED",
              "operator": {
                "type": "string",
                "operation": "equals",
                "name": "filter.operator.equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1168,
        80
      ],
      "id": "3e6b4dfe-baf1-4ec2-bee1-2c71e0dfcd7f",
      "name": "Completed?"
    },
    {
      "parameters": {
        "authentication": "privateKey",
        "command": "={{ 'sudo /opt/security-scanner/scripts/check-full-scan.sh ' + $('Scan ID').first().json.scan_id }}"
      },
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [
        672,
        64
      ],
      "id": "84b84e98-2ea2-41df-a1c1-2ff342356380",
      "name": "Check FULL"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "d730c87e-3b8d-4daf-bd64-e91a4db2b362",
              "leftValue": "={{ (!['STARTING', 'RUNNING', 'COMPLETED'].includes($json.status) || Number($json.code ?? 0) !== 0 || $json.signal) ? 'FAILED' : $json.status }}",
              "rightValue": "FAILED",
              "operator": {
                "type": "string",
                "operation": "equals",
                "name": "filter.operator.equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        960,
        64
      ],
      "id": "46a3eb09-1ce8-4708-8cb2-94a6820cf07e",
